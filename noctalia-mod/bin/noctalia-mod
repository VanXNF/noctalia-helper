#!/usr/bin/env bash
# 被 source 的 lib 用相对路径解析：相对本脚本所在目录，而不是调用者的 cwd。
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1
NOCTALIA_MOD_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P) || exit 1
export NOCTALIA_MOD_ROOT

# shellcheck source=../lib/common.sh
source "$NOCTALIA_MOD_ROOT/lib/common.sh"
# shellcheck source=../lib/paths.sh
source "$NOCTALIA_MOD_ROOT/lib/paths.sh"
# shellcheck source=../lib/lock.sh
source "$NOCTALIA_MOD_ROOT/lib/lock.sh"
# shellcheck source=../lib/state.sh
source "$NOCTALIA_MOD_ROOT/lib/state.sh"
# shellcheck source=../lib/module-loader.sh
source "$NOCTALIA_MOD_ROOT/lib/module-loader.sh"
# shellcheck source=../lib/package-manager.sh
source "$NOCTALIA_MOD_ROOT/lib/package-manager.sh"
# shellcheck source=../lib/deploy.sh
source "$NOCTALIA_MOD_ROOT/lib/deploy.sh"
# shellcheck source=../lib/preset.sh
source "$NOCTALIA_MOD_ROOT/lib/preset.sh"
# shellcheck source=../lib/theme.sh
source "$NOCTALIA_MOD_ROOT/lib/theme.sh"
# shellcheck source=../lib/wallpaper.sh
source "$NOCTALIA_MOD_ROOT/lib/wallpaper.sh"
# shellcheck source=../lib/snapshot.sh
source "$NOCTALIA_MOD_ROOT/lib/snapshot.sh"
# shellcheck source=../lib/reference-check.sh
source "$NOCTALIA_MOD_ROOT/lib/reference-check.sh"

usage() {
    cat <<'USAGE'
Usage:
  noctalia-mod list
  noctalia-mod check
  noctalia-mod setup [module ...] [--yes] [--with <program> ...]
  noctalia-mod deps [module ...] [--yes]
  noctalia-mod plan [module ...]
  noctalia-mod install [module ...] [--yes]
  noctalia-mod preset <module> list
  noctalia-mod preset <module> apply|save|edit|delete <name> [--yes]
  noctalia-mod part <module> <slot> list|apply <name> [--yes]
  noctalia-mod theme sync|status
  noctalia-mod wallpapers [deploy|status|remove]
  noctalia-mod snapshot [note]
  noctalia-mod snapshot list|delete <id>
  noctalia-mod rollback [snapshot-id]
  noctalia-mod uninstall [module ...] [--yes]
  noctalia-mod status
USAGE
}

resolve_modules() {
    local -a requested=("$@")
    if ((${#requested[@]} == 0)); then
        mapfile -t requested < <(module_ids)
    fi
    ((${#requested[@]})) || { error 'no modules are available'; return 1; }
    local id
    for id in "${requested[@]}"; do
        module_load "$id" || return 1
    done
    RESOLVED_MODULES=("${requested[@]}")
}

collect_packages() {
    local id package
    PLAN_REPO_PACKAGES=()
    PLAN_AUR_PACKAGES=()
    for id in "$@"; do
        module_load "$id"
        for package in "${MODULE_REPO_PACKAGES[@]}"; do
            contains_word "$package" "${PLAN_REPO_PACKAGES[@]}" || PLAN_REPO_PACKAGES+=("$package")
        done
        for package in "${MODULE_AUR_PACKAGES[@]}"; do
            contains_word "$package" "${PLAN_AUR_PACKAGES[@]}" || PLAN_AUR_PACKAGES+=("$package")
        done
    done
}

print_plan() {
    local -a modules=("$@")
    collect_packages "${modules[@]}"
    printf 'Noctalia Mod pre-flight\n'
    environment_summary
    print_module_lines "${modules[@]}"
    print_missing_packages
    local unresolved
    unresolved=$(reference_check_unresolved) || true
    [[ -n $unresolved ]] && printf '%s\n' "$unresolved" | sed 's/^/unresolved-ref\t/'
    print_runtime_commands "${modules[@]}"
    return 0
}

# 预检行的拼装件：plan / deps / setup 共用，差别只在头部、可选菜单与确认时机。

# 这份清单声明了哪些包，以及此刻还差哪些。
print_declared_packages() {
    ((${#PLAN_REPO_PACKAGES[@]})) && printf 'repo\t%s\n' "$(join_by ' ' "${PLAN_REPO_PACKAGES[@]}")"
    ((${#PLAN_AUR_PACKAGES[@]})) && printf 'aur\t%s\n' "$(join_by ' ' "${PLAN_AUR_PACKAGES[@]}")"
    return 0
}

print_missing_packages() {
    local -a missing_repo=() missing_aur=()
    mapfile -t missing_repo < <(package_missing "${PLAN_REPO_PACKAGES[@]}")
    mapfile -t missing_aur < <(package_missing "${PLAN_AUR_PACKAGES[@]}")
    ((${#missing_repo[@]})) && printf 'missing-repo\t%s\n' "$(join_by ' ' "${missing_repo[@]}")"
    ((${#missing_aur[@]})) && printf 'missing-aur\t%s\n' "$(join_by ' ' "${missing_aur[@]}")"
    return 0
}

# AUR helper 只在真有 AUR 包要装时才谈：没 helper 就装不了，提前说出来。
print_aur_helper_if_needed() {
    local -a missing_aur=()
    local helper
    mapfile -t missing_aur < <(package_missing "${PLAN_AUR_PACKAGES[@]}")
    ((${#missing_aur[@]})) || return 0
    helper=$(package_aur_helper 2>/dev/null) || helper='none'
    printf 'aur-helper\t%s\n' "$helper"
}

# 配置部署清单（PLAN §5 第 4 步）：会覆盖什么、保留什么、reload 什么、有没有漂移。
print_module_lines() {
    local id target owner preserve recorded_fingerprint
    for id in "$@"; do
        module_load "$id"
        target=$(safe_target_path "$MODULE_TARGET")
        owner=external
        [[ $(module_state_get "$id" enabled 2>/dev/null || true) == 1 ]] && owner=managed
        printf 'module\t%s\t%s\t%s\n' "$id" "$target" "$owner"
        for preserve in "${MODULE_PRESERVE[@]}"; do
            [[ -e $target/$preserve || -L $target/$preserve ]] && printf 'preserve\t%s\t%s\n' "$id" "$preserve"
        done
        [[ -e $target || -L $target ]] && printf 'overwrite\t%s\t%s\n' "$id" "$target"
        ((${#MODULE_RELOAD_COMMAND[@]})) && printf 'reload\t%s\t%s\n' "$id" "$(join_by ' ' "${MODULE_RELOAD_COMMAND[@]}")"
        # 账本里的 preset 没了：这次要么冻结它、要么回退默认。预检里说出来，
        # 否则用户只看到 "installed: niri" 却不知道它根本没被碰过（PLAN §4）。
        local stored_preset deploy_mode
        stored_preset=$(module_state_get "$id" preset 2>/dev/null || true)
        if [[ -n $stored_preset ]]; then
            deploy_mode=$(preset_deploy_mode "$id")
            [[ $deploy_mode == ok ]] || printf 'preset-missing\t%s\t%s\t%s\n' "$id" "$stored_preset" "$deploy_mode"
        fi
        # 漂移：目标被本项目之外的东西改过（PLAN §1）。指纹只覆盖会覆盖的文件。
        recorded_fingerprint=$(module_state_get "$id" fingerprint 2>/dev/null || true)
        if [[ -n $recorded_fingerprint ]]; then
            if [[ ! -e $target && ! -L $target ]]; then
                printf 'drift\t%s\tmissing\n' "$id"
            elif [[ $(module_fingerprint "$target") != "$recorded_fingerprint" ]]; then
                printf 'drift\t%s\tchanged\n' "$id"
            fi
        fi
    done
    return 0
}

# 依赖阶段的独立预检：只讲软件包与程序，不掺配置内容（PLAN §7）。
print_dependency_plan() {
    local -a modules=("$@")
    collect_packages "${modules[@]}"
    printf 'Noctalia Mod dependency pre-flight\n'
    environment_summary
    print_declared_packages
    print_missing_packages
    print_aur_helper_if_needed
    print_runtime_commands "${modules[@]}"
    return 0
}

# setup 的合并预检：依赖与配置一次性摊开，确认一次，然后安静跑完（PLAN §0）。
# 可选项排在这里是它的唯一去处——默认不装，要装得在命令行上说 --with。
print_setup_plan() {
    local -a modules=("$@")
    printf 'Noctalia Mod setup\n'
    environment_summary
    printf 'modules\t%s\n' "$(join_by ' ' "${modules[@]}")"
    print_declared_packages
    print_missing_packages
    print_aur_helper_if_needed
    print_optional_programs "${modules[@]}"
    print_module_lines "${modules[@]}"
    print_missing_required_commands "${modules[@]}"
    return 0
}

# 悬空引用 / 未声明程序都是仓库缺陷，不是用户选择：部署前硬性拦下（PLAN §3）。
require_consistent_references() {
    local unresolved undeclared unbound failed=0
    unresolved=$(reference_check_unresolved) || true
    undeclared=$(command_check_undeclared) || true
    unbound=$(command_check_unbound) || true
    if [[ -n $unresolved ]]; then
        printf '%s\n' "$unresolved" | sed 's/^/unresolved-ref\t/'
        failed=1
    fi
    if [[ -n $undeclared ]]; then
        printf '%s\n' "$undeclared" | sed 's/^/undeclared-command\t/'
        failed=1
    fi
    if [[ -n $unbound ]]; then
        printf '%s\n' "$unbound" | sed 's/^/unbound-command\t/'
        failed=1
    fi
    ((failed)) || return 0
    error 'refusing to deploy: module sources have unresolved references or undeclared programs'
    return 1
}

# 运行时程序报告：包装完了不等于命令真的在 PATH 上（PLAN §10 P1-6）。
print_runtime_commands() {
    local module command package kind
    while IFS=$'\t' read -r module command package kind; do
        printf 'missing-%s\t%s\t%s\t%s\n' "$kind" "$module" "$command" "$package"
    done < <(runtime_command_report "$@")
    return 0
}

# setup 只要必需项：可选项在它自己那份 --with 菜单里已经列过一次了。
print_missing_required_commands() {
    local module command package kind
    while IFS=$'\t' read -r module command package kind; do
        [[ $kind == required ]] || continue
        printf 'missing-required\t%s\t%s\t%s\n' "$module" "$command" "$package"
    done < <(runtime_command_report "$@")
    return 0
}

# setup 的可选菜单：只列这台机器上还没有的声明项，--with 认的就是这些名字。
print_optional_programs() {
    local module command package state
    while IFS=$'\t' read -r module command package state; do
        [[ $state == missing ]] || continue
        printf 'optional\t%s\t%s\t%s\n' "$module" "$command" "$package"
    done < <(package_optional_catalog "$@")
    return 0
}

# --with 收集到的可选程序名。命令行不能绕过"谁 spawn 谁声明"的契约（PLAN §3），
# 所以只能点名模块声明过的可选程序，再由这里解析成包。
PLAN_OPTIONAL_PROGRAMS=()

# 解析出的包并进 PLAN_REPO_PACKAGES / PLAN_AUR_PACKAGES，于是预检、安装、记账
# 走的是同一条路径，不额外开一条装包通道。
resolve_optional_programs() {
    local -a modules=("$@") catalog=() available=()
    ((${#PLAN_OPTIONAL_PROGRAMS[@]})) || return 0
    mapfile -t catalog < <(package_optional_catalog "${modules[@]}")
    local line requested id command package state matched
    for requested in "${PLAN_OPTIONAL_PROGRAMS[@]}"; do
        is_safe_command_name "$requested" || {
            error "invalid optional program: $requested"
            return 1
        }
        matched=''
        for line in "${catalog[@]}"; do
            IFS=$'\t' read -r id command package state <<< "$line"
            [[ $command == "$requested" ]] || continue
            matched=yes
            [[ $package != '-' ]] || {
                error "--with $requested: no package is declared for it, nothing to install"
                return 1
            }
            if [[ $(package_source_for "$package" "${modules[@]}") == aur ]]; then
                contains_word "$package" "${PLAN_AUR_PACKAGES[@]}" || PLAN_AUR_PACKAGES+=("$package")
            else
                contains_word "$package" "${PLAN_REPO_PACKAGES[@]}" || PLAN_REPO_PACKAGES+=("$package")
            fi
        done
        [[ -n $matched ]] && continue
        available=()
        for line in "${catalog[@]}"; do
            IFS=$'\t' read -r id command package state <<< "$line"
            contains_word "$command" "${available[@]}" || available+=("$command")
        done
        error "--with $requested: not a declared optional program in the selected modules"
        ((${#available[@]})) && printf 'available: %s\n' "$(join_by ' ' "${available[@]}")" >&2
        return 1
    done
    return 0
}

confirm_plan() {
    local yes=$1 prompt=${2-'Apply this plan?'}
    [[ $yes == yes ]] && return 0
    [[ -t 0 ]] || {
        error "refusing a non-interactive run without --yes"
        return 1
    }
    local answer
    read -r -p "$prompt [y/N] " answer
    [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]]
}

# AUR helper 在动手之前就要确认，避免 repo 包装完了才卡在 AUR 上。
# 依赖阶段本身住在 lib/package-manager.sh（见 §7），这里只做编排。

record_modules() {
    local snapshot=$1
    shift
    local id target custom_paths preserve_paths part selected
    local -a part_pairs=()
    for id in "$@"; do
        # 被冻结的模块这次一个字节都没动：重算指纹会把漂移一起抹掉，等于替用户
        # 宣布"没变化"。账本留给上一次真正部署它的那回。
        contains_word "$id" "${MODULE_DEPLOY_FROZEN[@]}" && continue
        module_load "$id"
        target=$(safe_target_path "$MODULE_TARGET")
        custom_paths=$(find "$target" -name '*__custom__*' -printf '%P,' 2>/dev/null | sed 's/,$//' || true)
        preserve_paths=$(join_by ',' "${MODULE_PRESERVE[@]}")
        part_pairs=()
        for part in "${MODULE_PARTS[@]}"; do
            selected=$(module_state_get "$id" "part.$part" 2>/dev/null || true)
            [[ -n $selected ]] || selected=$(module_part_default "$part")
            part_pairs+=("part.$part" "$selected")
        done
        # 合并写入会保留没提到的键，所以模块删掉的零件插槽要在这里显式清掉。
        state_module_unset_prefix "$id" 'part.'
        module_state_write "$id" \
            enabled 1 \
            preset "$(module_state_get "$id" preset 2>/dev/null || printf '%s' "$MODULE_PRESET_DEFAULT")" \
            target "$MODULE_TARGET" \
            source_version "$(state_project_version)" \
            last_snapshot "$snapshot" \
            custom_paths "$custom_paths" \
            preserve_paths "$preserve_paths" \
            last_result success \
            fingerprint "$(module_fingerprint "$target")" \
            "${part_pairs[@]}"
    done
}

# 只记我们装下去的包；本来就装着的包不算我们的账（PLAN §7）。
record_installed_packages() {
    if ((${#PLAN_INSTALLED_REPO[@]})); then
        state_record_installed_packages repo "${PLAN_INSTALLED_REPO[@]}"
    fi
    if ((${#PLAN_INSTALLED_AUR[@]})); then
        state_record_installed_packages aur "${PLAN_INSTALLED_AUR[@]}"
    fi
    return 0
}

cmd_list() {
    local id
    printf 'module\ttarget\n'
    while IFS= read -r id; do
        module_load "$id"
        printf '%s\t%s\n' "$id" "$MODULE_TARGET"
    done < <(module_ids)
}

cmd_deps() {
    local yes=no arg
    local -a requested=() modules=() missing_repo=() missing_aur=()
    while (($#)); do
        arg=$1
        shift
        case $arg in
            --yes|--express) yes=yes ;;
            -*) error "unknown deps option: $arg"; return 2 ;;
            *) requested+=("$arg") ;;
        esac
    done
    resolve_modules "${requested[@]}" || return 1
    modules=("${RESOLVED_MODULES[@]}")
    print_dependency_plan "${modules[@]}"
    collect_packages "${modules[@]}"
    mapfile -t missing_repo < <(package_missing "${PLAN_REPO_PACKAGES[@]}")
    mapfile -t missing_aur < <(package_missing "${PLAN_AUR_PACKAGES[@]}")
    if ((${#missing_repo[@]} == 0 && ${#missing_aur[@]} == 0)); then
        log 'nothing to install'
        return 0
    fi
    confirm_plan "$yes" 'Install these packages?' || return 1
    install_dependencies || return 1
    record_installed_packages
    state_append_audit deps "$(join_by ',' "${modules[@]}")"
    log 'dependencies installed'
    # 包都装了不等于命令就在 PATH 上：再核一遍必需程序，别让用户到快捷键上才发现。
    local module command package kind
    while IFS=$'\t' read -r module command package kind; do
        [[ $kind == required ]] || continue
        warn "still missing after install: $command (package $package, module $module)"
    done < <(runtime_command_report "${modules[@]}")
}

cmd_check() {
    [[ $# -eq 0 ]] || { error 'check does not accept extra arguments'; return 2; }
    local unresolved undeclared unbound
    unresolved=$(reference_check_unresolved) || true
    undeclared=$(command_check_undeclared) || true
    unbound=$(command_check_unbound) || true
    if [[ -z $unresolved && -z $undeclared && -z $unbound ]]; then
        log 'reference check: every module reference and program declaration resolves'
        return 0
    fi
    printf 'kind\tmodule\titem\n'
    [[ -n $unresolved ]] && printf '%s\n' "$unresolved" | sed 's/^/unresolved-ref\t/'
    [[ -n $undeclared ]] && printf '%s\n' "$undeclared" | sed 's/^/undeclared-command\t/'
    [[ -n $unbound ]] && printf '%s\n' "$unbound" | sed 's/^/unbound-command\t/'
    error 'declare the path in MODULE_EXTERNAL_REFS, or declare the program in MODULE_REQUIRED/OPTIONAL/EXTERNAL_COMMANDS'
    return 1
}

cmd_plan() {
    local -a modules=()
    resolve_modules "$@" || return 1
    modules=("${RESOLVED_MODULES[@]}")
    print_plan "${modules[@]}"
}

cmd_install() {
    local yes=no arg part_slot=''
    local -a requested=() modules=()
    while (($#)); do
        arg=$1
        shift
        case $arg in
            --yes|--express) yes=yes ;;
            --part-slot)
                [[ $# -ge 1 ]] || { error '--part-slot requires a slot'; return 2; }
                part_slot=$1
                shift
                ;;
            --) ;;
            -*) error "unknown install option: $arg"; return 2 ;;
            *) requested+=("$arg") ;;
        esac
    done
    resolve_modules "${requested[@]}" || return 1
    modules=("${RESOLVED_MODULES[@]}")
    require_consistent_references || return 1
    print_plan "${modules[@]}"
    confirm_plan "$yes" || return 1
    install_dependencies || return 1
    record_installed_packages
    local snapshot id
    snapshot=$(snapshot_create auto "before install: $(join_by ',' "${modules[@]}")" "${modules[@]}") || return 1
    for id in "${modules[@]}"; do
        if ! module_deploy "$id" "$part_slot"; then
            error "deployment failed for $id; restoring $snapshot"
            snapshot_restore "$snapshot" no "${modules[@]}" || error 'automatic restore failed; inspect the snapshot before retrying'
            return 1
        fi
    done
    record_modules "$snapshot" "${modules[@]}"
    state_append_audit install "$(join_by ',' "${modules[@]}")"
    # 冻结的模块这次一个字节都没动，不能算进"已安装"里。
    local -a deployed=()
    for id in "${modules[@]}"; do
        contains_word "$id" "${MODULE_DEPLOY_FROZEN[@]}" || deployed+=("$id")
    done
    ((${#MODULE_DEPLOY_FROZEN[@]})) && warn "left as is (preset missing): $(join_by ', ' "${MODULE_DEPLOY_FROZEN[@]}")"
    ((${#deployed[@]})) && log "installed: $(join_by ', ' "${deployed[@]}")"
    finish_deploy
    return 0
}

# 初始化核心集：配置能真正跑起来的最小集合（PLAN §11 阶段 B）。niri 的默认配置
# spawn 的 kitty、nautilus、wpctl、notify-send 由 niri 自己的包清单带上，所以这里
# 只点名两个模块。其余三个是加固，要就得显式提名——无参数不等于"全都要"。
setup_default_modules() {
    printf 'niri\nnoctalia\n'
}

# 收尾总结：本次做了什么、配置落到哪、下一步与退路（PLAN §11 阶段 B）。
print_setup_summary() {
    local -a modules=("$@")
    local id target
    printf 'setup complete\n'
    if ((${#PLAN_INSTALLED_REPO[@]} || ${#PLAN_INSTALLED_AUR[@]})); then
        printf 'installed\t%s\n' \
            "$(join_by ' ' "${PLAN_INSTALLED_REPO[@]}" "${PLAN_INSTALLED_AUR[@]}")"
    else
        printf 'installed\tnothing (every package was already present)\n'
    fi
    for id in "${modules[@]}"; do
        module_load "$id"
        target=$(safe_target_path "$MODULE_TARGET")
        if contains_word "$id" "${MODULE_DEPLOY_FROZEN[@]}"; then
            printf 'frozen\t%s\t%s\n' "$id" "$(module_state_get "$id" preset 2>/dev/null || true)"
        else
            printf 'deployed\t%s\t%s\n' "$id" "$target"
        fi
    done
    printf 'next\tstart a niri session, or reload one already running, to pick it up\n'
    printf 'undo\tnoctalia-mod rollback\n'
    return 0
}

# 两段式的引导路径：依赖与配置一次摊开、确认一次、然后安静跑完（PLAN §0）。
# 不是 deps 套 install —— 那样会问两次、打印两份清单，也就不是"集中决策"了。
cmd_setup() {
    local yes=no arg
    local -a requested=() modules=() missing_repo=() missing_aur=()
    PLAN_OPTIONAL_PROGRAMS=()
    while (($#)); do
        arg=$1
        shift
        case $arg in
            --yes|--express) yes=yes ;;
            --with)
                [[ $# -ge 1 ]] || { error '--with requires a program name'; return 2; }
                PLAN_OPTIONAL_PROGRAMS+=("$1")
                shift
                ;;
            -*) error "unknown setup option: $arg"; return 2 ;;
            *) requested+=("$arg") ;;
        esac
    done
    if ((${#requested[@]} == 0)); then
        mapfile -t requested < <(setup_default_modules)
    fi
    resolve_modules "${requested[@]}" || return 1
    modules=("${RESOLVED_MODULES[@]}")
    # 仓库缺陷先拦下：引用悬空或程序没人声明时，装下去也是坏的（PLAN §3）。
    require_consistent_references || return 1
    collect_packages "${modules[@]}"
    resolve_optional_programs "${modules[@]}" || return 1
    print_setup_plan "${modules[@]}"
    mapfile -t missing_repo < <(package_missing "${PLAN_REPO_PACKAGES[@]}")
    mapfile -t missing_aur < <(package_missing "${PLAN_AUR_PACKAGES[@]}")
    if ((${#missing_repo[@]} || ${#missing_aur[@]})); then
        confirm_plan "$yes" 'Install these packages and deploy the configuration?' || return 1
    else
        confirm_plan "$yes" 'Deploy the configuration?' || return 1
    fi
    install_dependencies || return 1
    record_installed_packages
    if ((${#PLAN_INSTALLED_REPO[@]} || ${#PLAN_INSTALLED_AUR[@]})); then
        state_append_audit deps "$(join_by ',' "${modules[@]}")"
    else
        log 'nothing to install'
    fi
    local snapshot id
    snapshot=$(snapshot_create auto "before setup: $(join_by ',' "${modules[@]}")" "${modules[@]}") || return 1
    for id in "${modules[@]}"; do
        if ! module_deploy "$id"; then
            error "deployment failed for $id; restoring $snapshot"
            snapshot_restore "$snapshot" no "${modules[@]}" || error 'automatic restore failed; inspect the snapshot before retrying'
            return 1
        fi
    done
    record_modules "$snapshot" "${modules[@]}"
    state_append_audit setup "$(join_by ',' "${modules[@]}")"
    finish_deploy
    # 壁纸是用户可见的数据、在 ~/.config 之外，所以只有引导路径（从零到桌面）碰它；
    # `install` 的契约是"只动 ~/.config"。要单独重跑就用 `wallpapers deploy`。
    local wallpaper_report=''
    wallpaper_report=$(wallpaper_deploy) || warn 'wallpaper deploy failed; the wallpaper directory may be empty'
    print_setup_summary "${modules[@]}"
    [[ -n $wallpaper_report ]] && printf '%s\n' "$wallpaper_report"
}

cmd_preset() {
    local id=${1-} action=${2-} name=${3-} yes=no option install_rc=0
    [[ -n $id && -n $action ]] || { usage; return 2; }
    case $action in
        list)
            [[ $# -eq 2 ]] || { error 'preset list does not accept extra arguments'; return 2; }
            module_load "$id" || return 1
            printf 'preset\tsource\tactive\n'
            preset_catalog "$id"
            ;;
        apply|save|edit|delete)
            [[ -n $name ]] || { error "preset $action requires a preset name"; return 2; }
            # `apply default` 是正经操作——它就是把模块铺回随仓库发布的默认配置。
            # 反过来，default 不是一个能存/改/删的名字。
            if [[ $action != apply ]] && preset_is_reserved "$name"; then
                error "default is reserved: it means the shipped configuration, not a preset"
                return 1
            fi
            shift 3
            for option in "$@"; do
                if [[ $option == --yes || $option == --express ]]; then
                    yes=yes
                else
                    error "unknown preset option: $option"
                    return 2
                fi
            done
            module_load "$id" || return 1
            case $action in
                apply)
                    module_source_for_preset "$(module_root "$id")" "$name" >/dev/null || { error "unknown preset: $name"; return 1; }
                    local old_preset preset_was_set=no
                    old_preset=$(module_state_get "$id" preset 2>/dev/null || true)
                    [[ -n $old_preset ]] && preset_was_set=yes
                    state_module_set "$id" preset "$name"
                    if [[ $yes == yes ]]; then
                        cmd_install "$id" --yes || install_rc=$?
                    else
                        cmd_install "$id" || install_rc=$?
                    fi
                    if [[ ${install_rc:-0} -ne 0 ]]; then
                        if [[ $preset_was_set == yes ]]; then
                            state_module_set "$id" preset "$old_preset"
                        else
                            state_module_unset "$id" preset
                        fi
                        return 1
                    fi
                    ;;
                save)
                    # 覆盖一份用户自己写的预设是不可逆的，所以要问一次；官方名字由
                    # preset_save 拒绝，不给"永远不生效的同名目录"留活路。
                    if [[ $(preset_source_of "$id" "$name") == user ]]; then
                        confirm_plan "$yes" "Overwrite user preset $name of $id?" || return 1
                    fi
                    preset_save "$id" "$name" || return 1
                    state_append_audit preset-save "$id/$name"
                    log "preset saved: $id/$name"
                    ;;
                edit)
                    preset_edit "$id" "$name" || return 1
                    log "edit saved: apply it with: noctalia-mod preset $id apply $name"
                    ;;
                delete)
                    # 删掉正在用的那份：之后这个模块会冻结，直到换一个预设或重铺默认。
                    [[ $(module_state_get "$id" preset 2>/dev/null || true) == "$name" ]] && \
                        warn "preset $name is active for $id; it will be frozen until you apply another one"
                    preset_delete "$id" "$name" || return 1
                    state_append_audit preset-delete "$id/$name"
                    log "preset deleted: $id/$name"
                    ;;
            esac
            ;;
        *) error "unknown preset action: $action"; return 2 ;;
    esac
}

cmd_part() {
    local id=${1-} slot=${2-} action=${3-} name=${4-} yes=no option install_rc=0
    [[ -n $id && -n $slot && -n $action ]] || { usage; return 2; }
    module_load "$id"
    contains_word "$slot" "${MODULE_PARTS[@]}" || { error "unknown part slot: $slot"; return 1; }
    case $action in
        list)
            [[ $# -eq 3 ]] || { error 'part list does not accept extra arguments'; return 2; }
            find "$(module_root "$id")/parts/$slot" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | sort
            ;;
        apply)
            [[ -n $name ]] || { error 'part apply requires a part name'; return 2; }
            shift 4
            for option in "$@"; do
                if [[ $option == --yes || $option == --express ]]; then
                    yes=yes
                else
                    error "unknown part option: $option"
                    return 2
                fi
            done
            module_source_for_part "$(module_root "$id")" "$slot" "$name" >/dev/null || { error "unknown $slot part: $name"; return 1; }
            local old_part part_was_set=no
            old_part=$(module_state_get "$id" "part.$slot" 2>/dev/null || true)
            [[ -n $old_part ]] && part_was_set=yes
            state_module_set "$id" "part.$slot" "$name"
            if [[ $yes == yes ]]; then
                cmd_install "$id" --part-slot "$slot" --yes || install_rc=$?
            else
                cmd_install "$id" --part-slot "$slot" || install_rc=$?
            fi
            if [[ ${install_rc:-0} -ne 0 ]]; then
                if [[ $part_was_set == yes ]]; then
                    state_module_set "$id" "part.$slot" "$old_part"
                else
                    state_module_unset "$id" "part.$slot"
                fi
                return 1
            fi
            ;;
        *) error "unknown part action: $action"; return 2 ;;
    esac
}

cmd_snapshot() {
    case ${1-} in
        list)
            [[ $# -eq 1 ]] || { error 'snapshot list does not accept extra arguments'; return 2; }
            snapshot_list
            ;;
        delete)
            [[ $# -eq 2 && -n ${2-} ]] || { error 'snapshot delete requires exactly one id'; return 2; }
            snapshot_delete "$2"
            ;;
        *)
            [[ $# -le 1 ]] || { error 'snapshot accepts at most one note'; return 2; }
            local -a modules=()
            mapfile -t modules < <(state_enabled_modules)
            if ((${#modules[@]} == 0)); then
                mapfile -t modules < <(module_ids)
            fi
            local id
            id=$(snapshot_create manual "${1-}" "${modules[@]}") || return 1
            log "snapshot created: $id"
            ;;
    esac
}

cmd_rollback() {
    [[ $# -le 1 ]] || { error 'rollback accepts at most one snapshot id'; return 2; }
    local id=${1-} protect
    [[ -n $id ]] || id=$(snapshot_latest)
    [[ -n $id ]] || { error 'no snapshots are available'; return 1; }
    snapshot_exists "$id" || { error "snapshot not found: $id"; return 1; }
    local -a modules=()
    mapfile -t modules < <(state_enabled_modules)
    protect=$(snapshot_create pre-rollback "before rollback to $id" "${modules[@]}") || return 1
    snapshot_restore "$id" no
    state_append_audit rollback "$id"
    log "restored: $id (current state saved as $protect)"
}

cmd_uninstall() {
    local yes=no arg id snapshot
    local -a requested=() modules=()
    for arg in "$@"; do
        case $arg in
            --yes|--express) yes=yes ;;
            -*) error "unknown uninstall option: $arg"; return 2 ;;
            *) requested+=("$arg") ;;
        esac
    done
    if ((${#requested[@]})); then
        resolve_modules "${requested[@]}" || return 1
        modules=("${RESOLVED_MODULES[@]}")
    else
        mapfile -t modules < <(state_enabled_modules)
    fi
    ((${#modules[@]})) || { error 'no managed modules are installed'; return 1; }
    printf 'Noctalia Mod uninstall\n'
    for id in "${modules[@]}"; do
        module_load "$id"
        printf 'remove\t%s\t%s\n' "$id" "$(safe_target_path "$MODULE_TARGET")"
    done
    confirm_plan "$yes" || return 1
    for id in "${modules[@]}"; do
        snapshot=$(snapshot_for_module "$id")
        if [[ -n $snapshot ]] && snapshot_exists "$snapshot"; then
            snapshot_restore "$snapshot" no "$id"
        else
            # 回滚点没了就只能删自己铺的文件，用户原来的配置恢复不了——必须说出来，
            # 不能让它静悄悄地发生（PLAN §6）。
            if [[ -n $snapshot ]]; then
                warn "recovery snapshot $snapshot for $id is gone; original files cannot be restored"
            else
                warn "no recovery snapshot recorded for $id; original files cannot be restored"
            fi
            module_clear_managed_config "$id"
        fi
        module_state_remove "$id"
    done
    state_append_audit uninstall "$(join_by ',' "${modules[@]}")"
    log "uninstalled: $(join_by ', ' "${modules[@]}")"
}

# GTK 深浅同步（PLAN §10 P1-8）。部署收尾调一次，失败只警告：配置已经铺好了，
# 不该因为 gsettings 或会话不可用就把一次成功的部署弄成失败。
finish_deploy() {
    theme_sync >/dev/null || warn 'theme sync failed; GTK apps may not follow the current mode'
    return 0
}

cmd_theme() {
    case ${1-} in
        sync)
            [[ $# -le 1 ]] || { error 'theme sync does not accept extra arguments'; return 2; }
            theme_sync
            ;;
        status)
            [[ $# -eq 1 ]] || { error 'theme status does not accept extra arguments'; return 2; }
            theme_status
            ;;
        *) error 'theme takes sync or status'; return 2 ;;
    esac
}

cmd_wallpapers() {
    local action=${1-deploy}
    case $action in
        deploy)
            [[ $# -le 1 ]] || { error 'wallpapers deploy does not accept extra arguments'; return 2; }
            local report
            report=$(wallpaper_deploy) || return 1
            [[ -n $report ]] && printf '%s\n' "$report"
            state_append_audit wallpapers-deploy "$(wallpaper_dir)"
            ;;
        status)
            [[ $# -le 1 ]] || { error 'wallpapers status does not accept extra arguments'; return 2; }
            wallpaper_status
            ;;
        remove)
            [[ $# -le 1 ]] || { error 'wallpapers remove does not accept extra arguments'; return 2; }
            local report
            report=$(wallpaper_remove_managed) || return 1
            [[ -n $report ]] && printf '%s\n' "$report"
            state_append_audit wallpapers-remove "$(wallpaper_dir)"
            ;;
        *) error "unknown wallpapers action: $action"; return 2 ;;
    esac
}

cmd_status() {
    local id
    printf 'module\tstatus\tpreset\ttarget\n'
    while IFS= read -r id; do
        module_load "$id"
        printf '%s\t%s\t%s\t%s\n' "$id" \
            "$(module_state_get "$id" enabled 2>/dev/null || printf absent)" \
            "$(module_state_get "$id" preset 2>/dev/null || printf '%s' "$MODULE_PRESET_DEFAULT")" \
            "$(safe_target_path "$MODULE_TARGET")"
    done < <(module_ids)
}

main() {
    require_non_root || return 1
    ensure_project_dirs
    local command=${1-help}
    shift || true
    case $command in
        list) cmd_list "$@" ;;
        check) cmd_check "$@" ;;
        setup) with_project_lock cmd_setup "$@" ;;
        deps) with_project_lock cmd_deps "$@" ;;
        plan) cmd_plan "$@" ;;
        install) with_project_lock cmd_install "$@" ;;
        preset) with_project_lock cmd_preset "$@" ;;
        part) with_project_lock cmd_part "$@" ;;
        theme) cmd_theme "$@" ;;
        wallpapers) with_project_lock cmd_wallpapers "$@" ;;
        snapshot) with_project_lock cmd_snapshot "$@" ;;
        rollback) with_project_lock cmd_rollback "$@" ;;
        uninstall) with_project_lock cmd_uninstall "$@" ;;
        status) cmd_status "$@" ;;
        help|-h|--help) usage ;;
        *) error "unknown command: $command"; usage; return 2 ;;
    esac
}

main "$@"
